{
  "name": "@dbzdrums/notation",
  "version": "0.1.0",
  "description": "Type-safe drum-set bar notation with MusicXML and SVG output.",
  "author": "DBZDrums",
  "license": "BSD-3-Clause",
  "keywords": [
    "drums",
    "drum-notation",
    "musicxml",
    "music-notation",
    "svg",
    "typescript"
  ],
  "homepage": "https://github.com/DBZDrums/dbzdrums-notation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DBZDrums/dbzdrums-notation.git"
  },
  "bugs": {
    "url": "https://github.com/DBZDrums/dbzdrums-notation/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@12.0.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "setup:browsers": "playwright install chromium firefox",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "opensheetmusicdisplay": "2.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@xmldom/xmldom": "0.9.10",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
